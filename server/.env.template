# Copiato in .env da "npm run setup", che sostituisce i valori __GENERA__ con stringhe casuali.
# Non mettere mai .env sotto git.

# Postgres locale (embedded-postgres, vedi scripts/db.mjs). In produzione: Postgres in Docker.
DB_PORT=5433
DB_USER=lequote
DB_PASSWORD=__GENERA__
DB_NAME=lequote
DATABASE_URL=__DATABASE_URL__

# Vetrina (Vite) su 5173, back office Medusa su 9000.
STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

JWT_SECRET=__GENERA__
COOKIE_SECRET=__GENERA__

# Facoltativi.
# REDIS_URL=redis://localhost:6379
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Niente telemetria verso Medusa.
MEDUSA_DISABLE_TELEMETRY=true

# Archivio privato dei referti di analisi (default: server/private/filiera). Va incluso nei backup.
# FILIERA_FILES_DIR=
