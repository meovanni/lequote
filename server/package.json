{
  "name": "lequote-server",
  "version": "0.1.0",
  "private": true,
  "description": "Le Quote: back end commerce, filiera e gestionale (Medusa v2).",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db": "node scripts/db.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "storefront-env": "medusa exec ./src/scripts/storefront-env.ts",
    "dev:stock": "medusa exec ./src/scripts/dev-stock.ts",
    "dev:lot": "medusa exec ./src/scripts/dev-lot.ts",
    "typecheck": "tsc --noEmit && tsc -p src/admin/tsconfig.json --noEmit",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cross-env": "^10.1.0",
    "embedded-postgres": "17.10.0-beta.17",
    "jest": "^30.5.2",
    "jsonwebtoken": "9.0.3",
    "jsqr": "^1.4.0",
    "pngjs": "^5.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
